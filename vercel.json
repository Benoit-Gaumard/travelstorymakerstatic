{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/blog/how-to-book-a-cheap-flight", "destination": "/guides/how-to-book-a-cheap-flight/", "permanent": true },
    { "source": "/blog/how-to-rent-a-car-while-traveling", "destination": "/guides/how-to-rent-a-car-while-traveling/", "permanent": true },
    { "source": "/blog/where-to-stay-while-traveling", "destination": "/guides/where-to-stay-while-traveling/", "permanent": true },
    { "source": "/blog/use-your-phone-while-traveling-abroad", "destination": "/guides/use-your-phone-while-traveling-abroad/", "permanent": true },
    { "source": "/blog/which-credit-card-to-use-abroad", "destination": "/guides/which-credit-card-to-use-abroad/", "permanent": true },
    { "source": "/blog/which-travel-insurance-to-choose", "destination": "/guides/which-travel-insurance-to-choose/", "permanent": true },
    { "source": "/blog/tips-and-tricks-for-traveling", "destination": "/guides/tips-and-tricks-for-traveling/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).(png|svg|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/site.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }]
    }
  ]
}
